APP_NAME=AiClip
APP_ENV=local
# APP_KEY is generated per deployment environment (php artisan key:generate).
# Never commit a real APP_KEY. Leave empty here; it must be set in production.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production log level must be info or error, never debug.
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aiclip
DB_USERNAME=aiclip
# DB_PASSWORD must be set per deployment environment. No default.
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum stateful domains must be production-configured via env.
# Example: SANCTUM_STATEFUL_DOMAINS=app.example.com,www.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Object storage (S3-compatible / MinIO). AWS_* credentials must come from
# the deployment environment. No defaults.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=aiclip-media
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Clip recommendation provider dispatched to the media worker.
# Allowed values: fake | cross_encoder
# Any other or unset value fails closed with invalid_configuration:
# there is no automatic detection and no fallback provider.
MEDIA_CLIP_RANKING_PROVIDER=fake

# Strict integer 1..120 worker timeout for the M5 stage; default 60.
# The row lock wait is always this value plus 5 seconds.
MEDIA_CLIP_RANKING_TIMEOUT_SECONDS=60

VITE_APP_NAME="${APP_NAME}"
# No VITE_API_BASE_URL here: local development uses the same-origin Vite /api
# proxy. The optional public origin override lives in apps/web/.env.example.

# Clip rendering timeout in seconds; default 300.
MEDIA_RENDER_TIMEOUT_SECONDS=300

# CORS allowed origins for production. Comma-separated, no wildcards when
# credentials are supported. Example: CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
