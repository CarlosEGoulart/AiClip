{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Media Processing Contract v1.0.0",
  "type": "object",
  "required": ["version", "media_asset_id", "project_id", "storage", "idempotency_key", "created_at"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "media_asset_id": { "type": "integer", "minimum": 1 },
    "project_id": { "type": "integer", "minimum": 1 },
    "storage": {
      "type": "object",
      "required": ["disk", "key", "mime_type"],
      "properties": {
        "disk": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 }
      }
    },
    "idempotency_key": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "action": {
      "type": "string",
      "enum": ["probe", "extract_audio", "transcribe", "detect_scenes", "analyze_clips", "rank_clips"],
      "default": "probe"
    },
    "output_storage": {
      "type": "object",
      "required": ["disk", "key", "mime_type"],
      "properties": {
        "disk": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 }
      }
    },
    "probe_data": {
      "type": "object",
      "description": "Probe result data from a prior probing stage. Required for extract_audio action.",
      "properties": {
        "duration_ms": { "type": "number", "minimum": 0 },
        "audio_codec": { "type": ["string", "null"] },
        "video_codec": { "type": ["string", "null"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "derived_asset_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Required for transcribe action. References DerivedAsset containing normalized audio."
    },
    "media": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scenes": {
      "type": "array",
      "description": "Scene boundaries for clip analysis. Required for analyze_clips action.",
      "items": {
        "type": "object",
        "required": ["index", "start_ms", "end_ms"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "transcript_segments": {
      "type": "array",
      "description": "Transcript timing segments for clip analysis. Optional for analyze_clips action.",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms"],
        "properties": {
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "candidates": {
      "type": "array",
      "description": "M4 clip candidates for rank_clips action.",
      "items": {
        "type": "object",
        "required": ["index", "start_ms", "end_ms", "rank", "transcript_text"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "transcript_text": { "type": "string" }
        }
      }
    },
    "configuration": {
      "type": "object",
      "description": "Configuration for analyze_clips or rank_clips action.",
      "properties": {
        "min_duration_ms": { "type": "integer", "minimum": 1 },
        "target_duration_ms": { "type": "integer", "minimum": 1 },
        "max_duration_ms": { "type": "integer", "minimum": 1 },
        "max_candidates": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "weights": {
          "type": "object",
          "required": ["duration_fit", "speech_coverage", "boundary_alignment"],
          "properties": {
            "duration_fit": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "speech_coverage": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "boundary_alignment": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        },
        "prototype_query": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "detect_scenes"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["media"],
        "properties": {
          "media": {
            "type": "object",
            "required": ["duration_ms"],
            "properties": {
              "duration_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "analyze_clips"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["media", "scenes", "configuration"],
        "properties": {
          "media": {
            "type": "object",
            "required": ["duration_ms"],
            "properties": {
              "duration_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rank_clips"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["media", "candidates", "configuration"],
        "properties": {
          "media": {
            "type": "object",
            "required": ["duration_ms"],
            "properties": {
              "duration_ms": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ]
}