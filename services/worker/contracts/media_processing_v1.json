{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Media Processing Contract v1.0.0",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "media_asset_id": { "type": "integer", "minimum": 1 },
    "recommendation_id": { "type": "integer", "minimum": 1 },
    "project_id": { "type": "integer", "minimum": 1 },
    "storage": {
      "type": "object",
      "required": ["disk", "key", "mime_type"],
      "properties": {
        "disk": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 }
      }
    },
    "idempotency_key": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "action": {
      "type": "string",
      "enum": ["probe", "extract_audio", "transcribe", "detect_scenes", "analyze_clips", "rank_clips", "render_clips", "render_clip"],
      "default": "probe"
    },
    "output_storage": {
      "type": "object",
      "required": ["disk", "key", "mime_type"],
      "properties": {
        "disk": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 }
      }
    },
    "probe_data": {
      "type": "object",
      "description": "Probe result data from a prior probing stage.",
      "properties": {
        "duration_ms": { "type": "number", "minimum": 0 },
        "audio_codec": { "type": ["string", "null"] },
        "video_codec": { "type": ["string", "null"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "derived_asset_id": {
      "type": "integer",
      "minimum": 1,
      "description": "References DerivedAsset containing normalized audio."
    },
    "media": {
      "type": "object",
      "required": ["duration_ms"],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scenes": {
      "type": "array",
      "description": "Scene boundaries for clip analysis. Required for analyze_clips action.",
      "items": {
        "type": "object",
        "required": ["index", "start_ms", "end_ms"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "candidates": {
      "type": "array",
      "description": "M4 clip candidates for rank_clips action.",
      "items": {
        "type": "object",
        "required": ["index", "start_ms", "end_ms", "rank", "transcript_text"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "transcript_text": { "type": "string" }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "description": "Recommendation data for render_clips action.",
      "properties": {
        "candidates": {
          "type": "array",
          "description": "Semantic-ranked clip candidates for rendering.",
          "items": {
            "type": "object",
            "required": ["index", "start_ms", "end_ms", "semantic_rank", "semantic_score"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "start_ms": { "type": "integer", "minimum": 0 },
              "end_ms": { "type": "integer", "minimum": 1 },
              "semantic_rank": { "type": "integer", "minimum": 1 },
              "semantic_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
            }
          }
        },
        "candidate_index": { "type": "integer", "minimum": 0 }
      }
    },
    "candidate_index": { "type": "integer", "minimum": 0 },
    "configuration": {
      "type": "object",
      "description": "Configuration for analyze_clips or rank_clips action.",
      "properties": {
        "min_duration_ms": { "type": "integer", "minimum": 1 },
        "target_duration_ms": { "type": "integer", "minimum": 1 },
        "max_duration_ms": { "type": "integer", "minimum": 1 },
        "max_candidates": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "weights": {
          "type": "object",
          "required": ["duration_fit", "speech_coverage", "boundary_alignment"],
          "properties": {
            "duration_fit": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "speech_coverage": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "boundary_alignment": { "type": "integer", "minimum": 0, "maximum": 10000 }
          }
        },
        "prototype_query": { "type": "string", "minLength": 1 },
        "provider": { "enum": ["fake", "cross_encoder"] }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "rank_clips_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "action", "media", "candidates", "configuration"],
      "properties": {
        "version": { "type": "string", "const": "1.0.0" },
        "action": { "type": "string", "const": "rank_clips" },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "start_ms", "end_ms", "m4_rank", "m4_score", "transcript_text"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "start_ms": { "type": "integer", "minimum": 0 },
              "end_ms": { "type": "integer", "minimum": 1 },
              "m4_rank": { "type": "integer", "minimum": 1 },
              "m4_score": { "type": "number", "minimum": 0, "maximum": 1 },
              "transcript_text": { "type": "string", "maxLength": 16384 }
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "algorithm",
            "algorithm_version",
            "projection_version",
            "query_version",
            "prototype_query",
            "model_id",
            "model_revision",
            "runtime_profile",
            "normalization",
            "max_tokens",
            "batch_size",
            "truncation"
          ],
          "properties": {
            "provider": { "type": "string", "enum": ["fake", "cross_encoder"] },
            "algorithm": { "type": "string", "const": "transcript_semantic_recommendation" },
            "algorithm_version": { "type": "string", "const": "1.0.0" },
            "projection_version": { "type": "string", "const": "1.0.0" },
            "query_version": { "type": "string", "const": "1.0.0" },
            "prototype_query": {
              "type": "string",
              "const": "Engaging, self-contained short-form video clip highlight with a clear narrative or punchline."
            },
            "model_id": { "type": "string", "minLength": 1 },
            "model_revision": { "type": "string", "minLength": 1 },
            "runtime_profile": { "type": "string", "minLength": 1 },
            "normalization": { "type": "string", "minLength": 1 },
            "max_tokens": { "type": "integer", "minimum": 0 },
            "batch_size": { "type": "integer", "minimum": 0 },
            "truncation": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "render_clips_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "action", "media", "recommendation", "candidate_index", "configuration", "source_media", "media_asset_id", "recommendation_id"],
      "properties": {
        "version": { "type": "string", "const": "1.0.0" },
        "action": { "type": "string", "const": "render_clips" },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        "recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidates", "candidate_index"],
          "properties": {
            "candidates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["index", "start_ms", "end_ms", "semantic_rank", "semantic_score"],
                "properties": {
                  "index": { "type": "integer", "minimum": 0 },
                  "start_ms": { "type": "integer", "minimum": 0 },
                  "end_ms": { "type": "integer", "minimum": 1 },
                  "semantic_rank": { "type": "integer", "minimum": 1 },
                  "semantic_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
                }
              }
            },
            "candidate_index": { "type": "integer", "minimum": 0 }
          }
        },
        "candidate_index": { "type": "integer", "minimum": 0 },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_width", "target_height", "target_fps",
            "video_codec", "video_bitrate_kbps",
            "audio_codec", "audio_bitrate_kbps"
          ],
          "properties": {
            "target_width": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "target_height": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "target_fps": { "type": "integer", "minimum": 1, "maximum": 120 },
            "video_codec": { "type": "string", "enum": ["libx264", "libx265", "h264_videotoolbox", "hevc_videotoolbox"] },
            "video_bitrate_kbps": { "type": "integer", "minimum": 500, "maximum": 50000 },
            "audio_codec": { "type": "string", "enum": ["aac", "libfdk_aac", "copy"] },
            "audio_bitrate_kbps": { "type": "integer", "minimum": 32, "maximum": 320 }
          }
        },
        "source_media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disk", "key", "width", "height", "video_codec", "audio_codec"],
          "properties": {
            "disk": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "video_codec": { "type": "string", "minLength": 1 },
            "audio_codec": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "media_asset_id": { "type": "integer", "minimum": 1 },
        "recommendation_id": { "type": "integer", "minimum": 1 }
      }
    },
    "render_clip_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "action", "media", "candidate_index", "candidate", "configuration", "source_media", "output_storage"],
      "properties": {
        "version": { "type": "string", "const": "1.0.0" },
        "action": { "type": "string", "const": "render_clip" },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["duration_ms"],
          "properties": {
            "duration_ms": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        "candidate_index": { "type": "integer", "minimum": 0 },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_ms", "end_ms"],
          "properties": {
            "start_ms": { "type": "integer", "minimum": 0 },
            "end_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_width", "target_height", "target_fps",
            "video_codec", "video_bitrate_kbps",
            "audio_codec", "audio_bitrate_kbps"
          ],
          "properties": {
            "target_width": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "target_height": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "target_fps": { "type": "integer", "minimum": 1, "maximum": 120 },
            "video_codec": { "type": "string", "enum": ["libx264", "libx265", "h264_videotoolbox", "hevc_videotoolbox"] },
            "video_bitrate_kbps": { "type": "integer", "minimum": 500, "maximum": 50000 },
            "audio_codec": { "type": "string", "enum": ["aac", "libfdk_aac", "copy"] },
            "audio_bitrate_kbps": { "type": "integer", "minimum": 32, "maximum": 320 },
            "captions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "font_file": { "type": "string", "minLength": 1 },
                "font_size": { "type": "integer", "minimum": 12, "maximum": 200 },
                "font_color": { "type": "string", "pattern": "^[0-9a-f]{6}$" },
                "outline_color": { "type": "string", "pattern": "^[0-9a-f]{6}$" },
                "outline_width": { "type": "integer", "minimum": 0, "maximum": 10 },
                "background_color": { "type": "string", "pattern": "^[0-9a-f]{6}$" },
                "background_opacity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "box_padding": { "type": "integer", "minimum": 0, "maximum": 50 },
                "margin_bottom": { "type": "integer", "minimum": 0, "maximum": 500 },
                "max_chars_per_line": { "type": "integer", "minimum": 10, "maximum": 80 }
              }
            }
          }
        },
        "source_media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disk", "key", "width", "height", "video_codec", "audio_codec"],
          "properties": {
            "disk": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "video_codec": { "type": "string", "minLength": 1 },
            "audio_codec": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "output_storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disk", "key", "mime_type"],
          "properties": {
            "disk": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 },
            "mime_type": { "type": "string", "const": "video/mp4" }
          }
        },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start_ms", "end_ms", "text"],
                "properties": {
                  "start_ms": { "type": "integer", "minimum": 0 },
                  "end_ms": { "type": "integer", "minimum": 0 },
                  "text": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "render_clips_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "render"],
      "properties": {
        "status": { "type": "string", "const": "success" },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "algorithm_version", "parameters", "clips"],
          "properties": {
            "algorithm": { "type": "string", "const": "ffmpeg_vertical_baseline" },
            "algorithm_version": { "type": "string", "const": "1.0.0" },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": ["configuration", "source_media", "ffmpeg_version", "filter_graph", "limits"],
              "properties": {
                "configuration": { "type": "object" },
                "source_media": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["disk", "key", "duration_ms", "width", "height", "video_codec", "audio_codec"],
                  "properties": {
                    "disk": { "type": "string" },
                    "key": { "type": "string" },
                    "duration_ms": { "type": "integer" },
                    "width": { "type": "integer" },
                    "height": { "type": "integer" },
                    "video_codec": { "type": "string" },
                    "audio_codec": { "type": ["string", "null"] }
                  }
                },
                "ffmpeg_version": { "type": "string" },
                "filter_graph": { "type": "string" },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["max_recommendations", "max_input_bytes", "max_duration_ms"],
                  "properties": {
                    "max_recommendations": { "type": "integer", "const": 1000 },
                    "max_input_bytes": { "type": "integer", "const": 8388608 },
                    "max_duration_ms": { "type": "integer", "const": 2147483647 }
                  }
                }
              }
            },
            "clips": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "candidate_index", "semantic_rank", "semantic_score",
                  "start_ms", "end_ms", "duration_ms", "output"
                ],
                "properties": {
                  "candidate_index": { "type": "integer", "minimum": 0 },
                  "semantic_rank": { "type": "integer", "minimum": 1 },
                  "semantic_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                  "start_ms": { "type": "integer", "minimum": 0 },
                  "end_ms": { "type": "integer", "minimum": 1 },
                  "duration_ms": { "type": "integer", "minimum": 1 },
                  "output": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "disk", "key", "size_bytes", "duration_ms",
                      "width", "height", "video_codec", "audio_codec",
                      "video_bitrate_kbps", "audio_bitrate_kbps"
                    ],
                    "properties": {
                      "disk": { "type": "string" },
                      "key": { "type": "string" },
                      "size_bytes": { "type": "integer", "minimum": 1 },
                      "duration_ms": { "type": "integer", "minimum": 1 },
                      "width": { "type": "integer", "minimum": 1 },
                      "height": { "type": "integer", "minimum": 1 },
                      "video_codec": { "type": "string" },
                      "audio_codec": { "type": "string" },
                      "video_bitrate_kbps": { "type": "integer", "minimum": 1 },
                      "audio_bitrate_kbps": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": { "required": ["action"] }
      },
      "then": {
        "required": ["project_id", "storage", "idempotency_key", "created_at"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "probe"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["project_id", "storage", "idempotency_key", "created_at"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "extract_audio"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["project_id", "storage", "idempotency_key", "created_at"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "transcribe"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["project_id", "storage", "idempotency_key", "created_at"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "detect_scenes"
          }
        },
        "required": ["action"]
      },
      "then": {
        "allOf": [
          { "required": ["project_id", "storage", "idempotency_key", "created_at", "media"] },
          {
            "properties": {
              "media": {
                "type": "object",
                "required": ["duration_ms"],
                "properties": {
                  "duration_ms": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "analyze_clips"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["project_id", "storage", "idempotency_key", "created_at", "media", "scenes", "configuration"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "rank_clips"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["media", "candidates", "configuration"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "render_clips"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["media", "recommendation", "candidate_index", "configuration", "source_media", "recommendation_id"]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "render_clip"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["media", "candidate_index", "candidate", "configuration", "source_media", "output_storage"]
      }
    }
  ]
}